# ============================================================
# Multi-Agent Supply Chain Automation - environment template
# Copy to .env (backend) and frontend/.env.local as needed.
# NEVER commit real secrets.
# ============================================================

# ---------- Database (Supabase PostgreSQL) ----------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the *connection pooler* (port 6543) URL for serverless deployments.
# Example: postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:6543/postgres
# Optional: keep this empty in production. When DATABASE_URL is unset the backend
# falls back to a LOCAL DEVELOPMENT sqlite file (documented limitation, never prod).
ALLOW_SQLITE_FALLBACK=true

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional bucket used for model artifacts / uploaded CSV archive
SUPABASE_STORAGE_BUCKET=supply-chain-artifacts

# ---------- Backend ----------
APP_ENV=development
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Inline workflow execution budget (seconds) for the in-process background runner
WORKFLOW_INLINE_BUDGET_SECONDS=50
MODEL_ARTIFACT_DIR=backend/artifacts
MAX_UPLOAD_MB=5

# ---------- Frontend (must be prefixed NEXT_PUBLIC_) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
